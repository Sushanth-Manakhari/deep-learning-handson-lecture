 target="p6-32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p7" name="7 · Environment decision"><mxGraphModel dx="1200" dy="830" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="830" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p7-1" value="Where should I run the lab?" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#0b0b0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1140" height="30" as="geometry"/></mxCell><mxCell id="p7-2" value="Every path runs the same notebooks; the code adapts to the hardware it finds" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#52514e;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1140" height="22" as="geometry"/></mxCell><mxCell id="p7-3" value="Start" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#0b0b0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="124" y="635" width="244" height="20" as="geometry"/></mxCell><mxCell id="p7-4" value="Question" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#0b0b0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="124" y="665" width="244" height="20" as="geometry"/></mxCell><mxCell id="p7-5" value="Where you run it" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#0b0b0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="124" y="695" width="244" height="20" as="geometry"/></mxCell><mxCell id="p7-6" value="Tip" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#0b0b0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="124" y="725" width="244" height="20" as="geometry"/></mxCell><mxCell id="p7-7" value="Legend" style="rounded=1;arcSize=4;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#b8b7b1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#52514e;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="60" y="600" width="320" height="166" as="geometry"/></mxCell><mxCell id="p7-8" value="&lt;b&gt;Start: open the lecture notebook&lt;/b&gt;" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f1f1ef;strokeColor=#52514e;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="100" width="300" height="56" as="geometry"/></mxCell><mxCell id="p7-9" value="&lt;b&gt;Colab gives you a T4 GPU?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0b0b0b;fillColor=#fff6e0;strokeColor=#b07800;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="455" y="196" width="250" height="110" as="geometry"/></mxCell><mxCell id="p7-10" value="&lt;b&gt;Kaggle account phone-verified?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0b0b0b;fillColor=#fff6e0;strokeColor=#b07800;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="455" y="360" width="250" height="110" as="geometry"/></mxCell><mxCell id="p7-11" value="&lt;b&gt;Laptop with NVIDIA GPU or Apple Silicon?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0b0b0b;fillColor=#fff6e0;strokeColor=#b07800;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="455" y="524" width="250" height="110" as="geometry"/></mxCell><mxCell id="p7-12" value="&lt;b&gt;Google Colab (primary)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;GPU profile: ResNet-50, full data&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="215" width="330" height="72" as="geometry"/></mxCell><mxCell id="p7-13" value="&lt;b&gt;Kaggle Notebooks (backup)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Accelerator GPU T4 · Internet On&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="379" width="330" height="72" as="geometry"/></mxCell><mxCell id="p7-14" value="&lt;b&gt;Local .venv (CUDA or MPS)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;setup_mac.sh · setup_windows.ps1&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="820" y="543" width="330" height="72" as="geometry"/></mxCell><mxCell id="p7-15" value="&lt;b&gt;FAST mode on CPU, or pair up&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ResNet-18 @ 160 px · data subset&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="690" width="300" height="72" as="geometry"/></mxCell><mxCell id="p7-16" value="&lt;b&gt;Before class&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Run 00_preflight_check once. It checks packages, GPU, data and models and prints OK or the fix.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="196" width="320" height="150" as="geometry"/></mxCell><mxCell id="p7-17" value="&lt;b&gt;In class&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Every section starts with a catch-up cell, so you can switch environment and continue.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="320" height="130" as="geometry"/></mxCell><mxCell id="p7-18" value="" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f1f1ef;strokeColor=#52514e;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="636" width="40" height="18" as="geometry"/></mxCell><mxCell id="p7-19" value="" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fff6e0;strokeColor=#b07800;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="666" width="40" height="18" as="geometry"/></mxCell><mxCell id="p7-20" value="" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="696" width="40" height="18" as="geometry"/></mxCell><mxCell id="p7-21" value="" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="72" y="726" width="40" height="18" as="geometry"/></mxCell><mxCell id="p7-22" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#0b0b0b;strokeColor=#52514e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-8" target="p7-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-23" value="yes" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#0b0b0b;strokeColor=#52514e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-9" target="p7-12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-24" value="no" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#0b0b0b;strokeColor=#52514e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-9" target="p7-10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-25" value="yes" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#0b0b0b;strokeColor=#52514e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-10" target="p7-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-26" value="no" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#0b0b0b;strokeColor=#52514e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-10" target="p7-11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-27" value="yes" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#0b0b0b;strokeColor=#52514e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-11" target="p7-14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p7-28" value="no" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#0b0b0b;strokeColor=#52514e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p7-11" target="p7-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p8" name="8 · Lecture flow"><mxGraphModel dx="1500" dy="620" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="620" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p8-1" value="Lecture flow · Thursday, November 19, 2026 · 4:00–5:30 PM" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#0b0b0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1440" height="30" as="geometry"/></mxCell><mxCell id="p8-2" value="80 minutes hands-on + 10 minutes Q&amp;amp;A; each block maps to a notebook section" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#52514e;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1440" height="22" as="geometry"/></mxCell><mxCell id="p8-3" value="Both projects use the same recipe: pretrained model → new last layer → gentle fine-tuning. Cells 3.9, 3.14, 5.4 and 5.6 are skipped in class (marked in the notebook); try them at home." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#52514e;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="548" width="1420" height="40" as="geometry"/></mxCell><mxCell id="p8-4" value="&lt;b&gt;4:00&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#ffffff;fillColor=#2a78d6;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="70" y="96" width="100" height="34" as="geometry"/></mxCell><mxCell id="p8-5" value="&lt;b&gt;Setup&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;§0 · 5 min&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="166" width="160" height="70" as="geometry"/></mxCell><mxCell id="p8-6" value="Open the notebook from the QR code · turn on the T4 GPU · run the 3 setup cells (they download while we talk)" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="272" width="160" height="250" as="geometry"/></mxCell><mxCell id="p8-7" value="&lt;b&gt;4:05&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#ffffff;fillColor=#2a78d6;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="250" y="96" width="100" height="34" as="geometry"/></mxCell><mxCell id="p8-8" value="&lt;b&gt;Why deep learning&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;§1 · 5 min&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="166" width="160" height="70" as="geometry"/></mxCell><mxCell id="p8-9" value="Computers learn what to look for: hand-made features 70.7% vs a pretrained model 88.7% · why a GPU (28× faster)" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="220" y="272" width="160" height="250" as="geometry"/></mxCell><mxCell id="p8-10" value="&lt;b&gt;4:10&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#ffffff;fillColor=#2a78d6;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="430" y="96" width="100" height="34" as="geometry"/></mxCell><mxCell id="p8-11" value="&lt;b&gt;How a model learns&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;§2 · 12 min&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="166" width="160" height="70" as="geometry"/></mxCell><mxCell id="p8-12" value="Small steps downhill, by hand · PyTorch does the calculus · how big each step should be · the five-line training loop" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400" y="272" width="160" height="250" as="geometry"/></mxCell><mxCell id="p8-13" value="&lt;b&gt;4:22&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#ffffff;fillColor=#2a78d6;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="610" y="96" width="100" height="34" as="geometry"/></mxCell><mxCell id="p8-14" value="&lt;b&gt;Project 1: leaf disease&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;§3 · 28 min&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="166" width="160" height="70" as="geometry"/></mxCell><mxCell id="p8-15" value="Look at the data · the score to beat · reuse ResNet · more photos for free · 3-min challenge · fine-tuning · test set 90.6% · unsure → ask a human" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="580" y="272" width="160" height="250" as="geometry"/></mxCell><mxCell id="p8-16" value="&lt;b&gt;4:50&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#ffffff;fillColor=#2a78d6;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spaci