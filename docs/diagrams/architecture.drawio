"1" parent="1"><mxGeometry x="350" y="140" width="230" height="96" as="geometry"/></mxCell><mxCell id="p4-9" value="&lt;b&gt;FAST profile&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ResNet-18 @ 160 px · data subset · fewer epochs&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="150" width="330" height="76" as="geometry"/></mxCell><mxCell id="p4-10" value="&lt;b&gt;Banner: how to switch to T4&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;the lab still finishes, just slower&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="150" width="330" height="76" as="geometry"/></mxCell><mxCell id="p4-11" value="&lt;b&gt;Dataset Release unreachable or altered&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;network error / tampered file&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fde9ea;strokeColor=#c93a39;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="266" width="250" height="76" as="geometry"/></mxCell><mxCell id="p4-12" value="&lt;b&gt;download fails or SHA-256 differs?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0b0b0b;fillColor=#fff6e0;strokeColor=#b07800;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="256" width="230" height="96" as="geometry"/></mxCell><mxCell id="p4-13" value="&lt;b&gt;Refuse file · fall back to Hugging Face&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;zip-slip guard on every extraction&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="266" width="330" height="76" as="geometry"/></mxCell><mxCell id="p4-14" value="&lt;b&gt;Same data, slower download&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;no action needed&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="266" width="330" height="76" as="geometry"/></mxCell><mxCell id="p4-15" value="&lt;b&gt;Hugging Face also unreachable&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;no internet / Kaggle Internet off&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fde9ea;strokeColor=#c93a39;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="382" width="250" height="76" as="geometry"/></mxCell><mxCell id="p4-16" value="&lt;b&gt;both sources failed?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0b0b0b;fillColor=#fff6e0;strokeColor=#b07800;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="372" width="230" height="96" as="geometry"/></mxCell><mxCell id="p4-17" value="&lt;b&gt;Stop with a clear message&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&amp;quot;check the connection (Kaggle: Internet On)&amp;quot;&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="382" width="330" height="76" as="geometry"/></mxCell><mxCell id="p4-18" value="&lt;b&gt;Actionable message, not a stack trace&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;fix and re-run the cell&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="382" width="330" height="76" as="geometry"/></mxCell><mxCell id="p4-19" value="&lt;b&gt;Loss explodes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;learning rate too high · bad inputs&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fde9ea;strokeColor=#c93a39;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="498" width="250" height="76" as="geometry"/></mxCell><mxCell id="p4-20" value="&lt;b&gt;loss is inf or NaN?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0b0b0b;fillColor=#fff6e0;strokeColor=#b07800;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="488" width="230" height="96" as="geometry"/></mxCell><mxCell id="p4-21" value="&lt;b&gt;NaN guard stops training&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;fp16: GradScaler skips the bad step&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="498" width="330" height="76" as="geometry"/></mxCell><mxCell id="p4-22" value="&lt;b&gt;Explanation and fixes&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;lower LR · clip gradients · warm-up&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="498" width="330" height="76" as="geometry"/></mxCell><mxCell id="p4-23" value="&lt;b&gt;GPU out of memory&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;batch or images too large&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fde9ea;strokeColor=#c93a39;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="614" width="250" height="76" as="geometry"/></mxCell><mxCell id="p4-24" value="&lt;b&gt;out-of-memory error?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0b0b0b;fillColor=#fff6e0;strokeColor=#b07800;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="604" width="230" height="96" as="geometry"/></mxCell><mxCell id="p4-25" value="&lt;b&gt;Catch it, free memory, continue&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;report the largest batch that fits&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="614" width="330" height="76" as="geometry"/></mxCell><mxCell id="p4-26" value="&lt;b&gt;Batch size vs memory table&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;notebook stays alive&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="614" width="330" height="76" as="geometry"/></mxCell><mxCell id="p4-27" value="&lt;b&gt;Optimizer misses the new head&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;head replaced after the optimizer was built&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fde9ea;strokeColor=#c93a39;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="250" height="76" as="geometry"/></mxCell><mxCell id="p4-28" value="&lt;b&gt;overfit-one-batch fails?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0b0b0b;fillColor=#fff6e0;strokeColor=#b07800;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="720" width="230" height="96" as="geometry"/></mxCell><mxCell id="p4-29" value="&lt;b&gt;optimizer_covers_model()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;lists the missing tensors&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="730" width="330" height="76" as="geometry"/></mxCell><mxCell id="p4-30" value="&lt;b&gt;FAIL → fix → PASS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;the bug is found in seconds&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="730" width="330" height="76" as="geometry"/></mxCell><mxCell id="p4-31" value="&lt;b&gt;Lost notebook state&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;restart · skipped cells · typo&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fde9ea;strokeColor=#c93a39;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="846" width="250" height="76" as="geometry"/></mxCell><mxCell id="p4-32" value="&lt;b&gt;variables missing?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0b0b0b;fillColor=#fff6e0;strokeColor=#b07800;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="836" width="230" height="96" as="geometry"/></mxCell><mxCell id="p4-33" value="&lt;b&gt;Catch-up cell rebuilds state&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;loads cached checkpoints instead of retraining&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="846" width="330" height="76" as="geometry"/></mxCell><mxCell id="p4-34" value="&lt;b&gt;Back in sync&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;continue with the class&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="846" width="330" height="76" as="geometry"/></mxCell><mxCell id="p4-35" value="&lt;b&gt;Public demo link fails&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;share service blocked&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fde9ea;strokeColor=#c93a39;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="962" width="250" height="76" as="geometry"/></mxCell><mxCell id="p4-36" value="&lt;b&gt;launch() raises?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0b0b0b;fillColor=#fff6e0;strokeColor=#b07800;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="350" y="952" width="230" height="96" as="geometry"/></mxCell><mxCell id="p4-37" value="&lt;b&gt;Keep the inline app&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;in-notebook photo upload as fallback&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="962" width="330" height="76" as="geometry"/></mxCell><mxCell id="p4-38" value="&lt;b&gt;Demo still works&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;on the laptop instead of the phone&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030" y="962" width="330" height="76" as="geometry"/></mxCell><mxCel