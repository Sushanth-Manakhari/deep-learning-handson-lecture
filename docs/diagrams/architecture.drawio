ign=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#0b0b0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1240" height="30" as="geometry"/></mxCell><mxCell id="p6-2" value="Each risk, the control that addresses it, and where it lives in the code" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#52514e;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1240" height="22" as="geometry"/></mxCell><mxCell id="p6-3" value="&lt;b&gt;Risk&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#0b0b0b;fillColor=none;strokeColor=none;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="88" width="330" height="34" as="geometry"/></mxCell><mxCell id="p6-4" value="&lt;b&gt;Control&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#0b0b0b;fillColor=none;strokeColor=none;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="88" width="400" height="34" as="geometry"/></mxCell><mxCell id="p6-5" value="&lt;b&gt;Implemented in&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#0b0b0b;fillColor=none;strokeColor=none;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="88" width="350" height="34" as="geometry"/></mxCell><mxCell id="p6-6" value="&lt;b&gt;Malicious model files&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;pickle can run code when loaded&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fde9ea;strokeColor=#c93a39;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="330" height="64" as="geometry"/></mxCell><mxCell id="p6-7" value="&lt;b&gt;safetensors for every checkpoint&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;raw tensors only · trust_remote_code never used&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="130" width="400" height="64" as="geometry"/></mxCell><mxCell id="p6-8" value="&lt;b&gt;train.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;save_checkpoint / load_checkpoint&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="130" width="350" height="64" as="geometry"/></mxCell><mxCell id="p6-9" value="&lt;b&gt;Tampered or corrupted dataset&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;download altered in transit&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fde9ea;strokeColor=#c93a39;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="212" width="330" height="64" as="geometry"/></mxCell><mxCell id="p6-10" value="&lt;b&gt;SHA-256 check before use&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;hash recorded in data/beans_pack.json&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="212" width="400" height="64" as="geometry"/></mxCell><mxCell id="p6-11" value="&lt;b&gt;data_vision.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;_from_release()&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="212" width="350" height="64" as="geometry"/></mxCell><mxCell id="p6-12" value="&lt;b&gt;Path traversal in archives&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&amp;#x27;zip-slip&amp;#x27; writes outside the folder&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fde9ea;strokeColor=#c93a39;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="294" width="330" height="64" as="geometry"/></mxCell><mxCell id="p6-13" value="&lt;b&gt;Reject absolute or &amp;#x27;..&amp;#x27; paths&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;checked for every zip member&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="440" y="294" width="400" height="64" as="geometry"/></mxCell><mxCell id="p6-14" value="&lt;b&gt;data_vision.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;zip extraction&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="910" y="294" width="350" height="64" as="geometry"/></mxCell><mxCell id="p6-15" value="&lt;b&gt;Leaked 