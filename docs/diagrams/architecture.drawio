 a model safely" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="940" y="272" width="160" height="250" as="geometry"/></mxCell><mxCell id="p8-22" value="&lt;b&gt;5:15&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#ffffff;fillColor=#2a78d6;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1150" y="96" width="100" height="34" as="geometry"/></mxCell><mxCell id="p8-23" value="&lt;b&gt;Wrap-up&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;§6 · 5 min&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="166" width="160" height="70" as="geometry"/></mxCell><mxCell id="p8-24" value="What you built today · where this leads: LLMs, LoRA, RAG · take-home projects" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120" y="272" width="160" height="250" as="geometry"/></mxCell><mxCell id="p8-25" value="&lt;b&gt;5:20&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#ffffff;fillColor=#2a78d6;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1330" y="96" width="100" height="34" as="geometry"/></mxCell><mxCell id="p8-26" value="&lt;b&gt;Q&amp;amp;A&lt;/b&gt;&lt;br&gt;&lt;s