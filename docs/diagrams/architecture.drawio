ryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-32" target="p4-33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-59" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#0b0b0b;strokeColor=#52514e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-33" target="p4-34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-60" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#0b0b0b;strokeColor=#52514e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-35" target="p4-36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-61" value="yes" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#0b0b0b;strokeColor=#52514e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-36" target="p4-37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p4-62" value="" style="edgeStyle=none;rounded=0;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#0b0b0b;strokeColor=#52514e;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4-37" target="p4-38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5 · Model architecture"><mxGraphModel dx="1300" dy="930" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="930" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="p5-1" value="Model architecture: transfer learning on both tickets" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;fontStyle=1;fontColor=#0b0b0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1240" height="30" as="geometry"/></mxCell><mxCell id="p5-2" value="Keep the pretrained backbone, add a new head, then fine-tune the top with a small learning rate" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=13;fontStyle=0;fontColor=#52514e;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="30" y="50" width="1240" height="22" as="geometry"/></mxCell><mxCell id="p5-3" value="Frozen pretrained weights" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#0b0b0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="544" y="615" width="264" height="20" as="geometry"/></mxCell><mxCell id="p5-4" value="Fine-tuned in stage B" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#0b0b0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="544" y="645" width="264" height="20" as="geometry"/></mxCell><mxCell id="p5-5" value="New head (always trained)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#0b0b0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="544" y="675" width="264" height="20" as="geometry"/></mxCell><mxCell id="p5-6" value="Data / tokens / outputs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#0b0b0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="544" y="705" width="264" height="20" as="geometry"/></mxCell><mxCell id="p5-7" value="Confidence threshold" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#0b0b0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="544" y="735" width="264" height="20" as="geometry"/></mxCell><mxCell id="p5-8" value="Legend" style="rounded=1;arcSize=4;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#b8b7b1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#52514e;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="480" y="580" width="340" height="196" as="geometry"/></mxCell><mxCell id="p5-9" value="&lt;b&gt;Vision · ResNet-50 (25.6M parameters)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#0b0b0b;fillColor=none;strokeColor=none;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="88" width="380" height="34" as="geometry"/></mxCell><mxCell id="p5-10" value="&lt;b&gt;Text · DistilBERT (66M parameters)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#0b0b0b;fillColor=none;strokeColor=none;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="88" width="380" height="34" as="geometry"/></mxCell><mxCell id="p5-11" value="&lt;b&gt;Leaf photo&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;224 × 224 × 3 RGB, normalised (x − μ) / σ&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="380" height="56" as="geometry"/></mxCell><mxCell id="p5-12" value="&lt;b&gt;conv1 + layer1 – layer3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;frozen in both stages · edges → textures → parts&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="216" width="380" height="64" as="geometry"/></mxCell><mxCell id="p5-13" value="&lt;b&gt;layer4 (3 residual blocks)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;frozen in stage A · fine-tuned in stage B (LR 1e-4)&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fdeee6;strokeColor=#c9541d;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="310" width="380" height="64" as="geometry"/></mxCell><mxCell id="p5-14" value="&lt;b&gt;Global average pooling&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;7 × 7 × 2048 → 2048 features&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="404" width="380" height="56" as="geometry"/></mxCell><mxCell id="p5-15" value="&lt;b&gt;New head: Linear 2048 → 3&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;6,147 trainable parameters (LR 1e-3)&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="490" width="380" height="56" as="geometry"/></mxCell><mxCell id="p5-16" value="&lt;b&gt;softmax → 3 probabilities&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;angular_leaf_spot · bean_rust · healthy&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="576" width="380" height="56" as="geometry"/></mxCell><mxCell id="p5-17" value="&lt;b&gt;Customer message&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;&amp;quot;My card got swallowed by the ATM!!&amp;quot;&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="130" width="380" height="56" as="geometry"/></mxCell><mxCell id="p5-18" value="&lt;b&gt;WordPiece tokenizer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;[CLS] my card got swallowed … [SEP] → ids&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="216" width="380" height="64" as="geometry"/></mxCell><mxCell id="p5-19" value="&lt;b&gt;Embeddings (768-d)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;token + position · frozen in A, trained in B&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fdeee6;strokeColor=#c9541d;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="310" width="380" height="64" as="geometry"/></mxCell><mxCell id="p5-20" value="&lt;b&gt;6 × Transformer layer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;self-attention + feed-forward · trained in B (LR 5e-5)&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fdeee6;strokeColor=#c9541d;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="404" width="380" height="70" as="geometry"/></mxCell><mxCell id="p5-21" value="&lt;b&gt;New head: 768 → 768 → 77&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;pre-classifier + ReLU + dropout + classifier&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="504" width="380" height="56" as="geometry"/></mxCell><mxCell id="p5-22" value="&lt;b&gt;softmax → 77 intent probabilities&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;e.g. card_swallowed 0.89&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="590" width="380" height="56" as="geometry"/></mxCell><mxCell id="p5-23" value="&lt;b&gt;max p ≥ τ = 0.89 ?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0b0b0b;fillColor=#fff6e0;strokeColor=#b07800;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="130" y="662" width="240" height="96" as="geometry"/></mxCell><mxCell id="p5-24" value="&lt;b&gt;Auto-diagnosis&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="170" height="56" as="geometry"/></mxCell><mxCell id="p5-25" value="&lt;b&gt;Agronomist review&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fde9ea;strokeColor=#c93a39;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="270" y="800" width="170" height="56" as="geometry"/></mxCell><mxCell id="p5-26" value="&lt;b&gt;max p ≥ τ = 0.79 ?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#0b0b0b;fillColor=#fff6e0;strokeColor=#b07800;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="930" y="676" width="240" height="96" as="geometry"/></mxCell><mxCell id="p5-27" value="&lt;b&gt;Auto-route intent&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="860" y="814" width="170" height="56" as="geometry"/></mxCell><mxCell id="p5-28" value="&lt;b&gt;Human support agent&lt;/b&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fde9ea;strokeColor=#c93a39;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1070" y="814" width="170" height="56" as="geometry"/></mxCell><mxCell id="p5-29" value="&lt;b&gt;Two training stages&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Stage A: train only the new head (green).&lt;br&gt;Stage B: also fine-tune the orange blocks with a smaller learning rate.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="130" width="340" height="130" as="geometry"/></mxCell><mxCell id="p5-30" value="&lt;b&gt;Residual connection (ResNet)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;y = F(x) + x  →  ∂y/∂x = ∂F/∂x + I&lt;br&gt;an identity path keeps gradients alive through 50 layers&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="290" width="340" height="110" as="geometry"/></mxCell><mxCell id="p5-31" value="&lt;b&gt;Self-attention (Transformer)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;softmax(Q·K^T / √d) · V&lt;br&gt;every token weighs every other token&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="430" width="340" height="110" as="geometry"/></mxCell><mxCell id="p5-32" value="" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="492" y="616" width="40" height="18" as="geometry"/></mxCell><mxCell id="p5-33" value="" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fdeee6;strokeColor=#c9541d;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="492" y="646" width="40" height="18" as="geometry"/></mxCell><mxCell id="p5-34" value="" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacing