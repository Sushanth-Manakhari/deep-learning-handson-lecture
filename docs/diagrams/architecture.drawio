;fontSize=11;fontStyle=0;fontColor=#0b0b0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="904" y="915" width="194" height="20" as="geometry"/></mxCell><mxCell id="p2-7" value="Decision" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#0b0b0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="904" y="945" width="194" height="20" as="geometry"/></mxCell><mxCell id="p2-8" value="Fallback / loop" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=0;fontColor=#0b0b0b;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="904" y="975" width="194" height="20" as="geometry"/></mxCell><mxCell id="p2-9" value="Legend" style="rounded=1;arcSize=4;dashed=1;dashPattern=6 4;fillColor=none;strokeColor=#b8b7b1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#52514e;html=1;whiteSpace=wrap;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="840" y="790" width="270" height="226" as="geometry"/></mxCell><mxCell id="p2-10" value="&lt;b&gt;IMAGES · Beans (LEAF-101)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#0b0b0b;fillColor=none;strokeColor=none;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="88" width="300" height="34" as="geometry"/></mxCell><mxCell id="p2-11" value="&lt;b&gt;TEXT · Banking77 (SUPPORT-202)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#0b0b0b;fillColor=none;strokeColor=none;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="810" y="88" width="300" height="34" as="geometry"/></mxCell><mxCell id="p2-12" value="&lt;b&gt;Hugging Face Hub (original)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;AI-Lab-Makerere/beans · parquet · ~180 MB · MIT&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;size=8;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="130" width="300" height="64" as="geometry"/></mxCell><mxCell id="p2-13" value="&lt;b&gt;build_beans_pack.py (once)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;decode · resize 224 px · JPEG q90 · zip&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="230" width="300" height="64" as="geometry"/></mxCell><mxCell id="p2-14" value="&lt;b&gt;GitHub Release data-v1&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;beans_224.zip · 26 MB · SHA-256 in beans_pack.json&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;size=8;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="330" width="300" height="64" as="geometry"/></mxCell><mxCell id="p2-15" value="&lt;b&gt;ensure_beans()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;download · verify SHA-256 · block zip-slip · unzip&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="430" width="300" height="64" as="geometry"/></mxCell><mxCell id="p2-16" value="&lt;b&gt;Transforms&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;train: crop, flip, rotate, colour jitter · all: x&amp;#x27; = (x − μ) / σ&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="530" width="300" height="64" as="geometry"/></mxCell><mxCell id="p2-17" value="&lt;b&gt;DataLoader&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;batch 32 · pixel_values [B,3,224,224] + labels&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="90" y="630" width="300" height="64" as="geometry"/></mxCell><mxCell id="p2-18" value="&lt;b&gt;PolyAI GitHub repository&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;banking_data/train.csv, test.csv · CC BY 4.0&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fdeee6;strokeColor=#c9541d;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="810" y="130" width="300" height="64" as="geometry"/></mxCell><mxCell id="p2-19" value="&lt;b&gt;data/banking77/ (committed)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;13,083 messages · 77 intents · ~1 MB&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;size=8;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="810" y="230" width="300" height="64" as="geometry"/></mxCell><mxCell id="p2-20" value="&lt;b&gt;load_banking77()&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;stratified split 9,002 / 1,001 / 3,080&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="810" y="330" width="300" height="64" as="geometry"/></mxCell><mxCell id="p2-21" value="&lt;b&gt;DistilBERT tokenizer&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;WordPiece · [CLS] … [SEP] · max 64 tokens&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="810" y="430" width="300" height="64" as="geometry"/></mxCell><mxCell id="p2-22" value="&lt;b&gt;TextClassificationDataset&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;pre-tokenised once (fast tokenizer)&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="810" y="530" width="300" height="64" as="geometry"/></mxCell><mxCell id="p2-23" value="&lt;b&gt;DataLoader + dynamic padding&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;batch 32 · input_ids, attention_mask + labels&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="810" y="630" width="300" height="64" as="geometry"/></mxCell><mxCell id="p2-24" value="&lt;b&gt;One batch format for both tickets&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Images → pixel_values [B, 3, 224, 224]&lt;br&gt;Text → input_ids + attention_mask [B, T]&lt;br&gt;Both → labels [B]&lt;br&gt;So ONE training loop serves both.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450" y="130" width="300" height="190" as="geometry"/></mxCell><mxCell id="p2-25" value="&lt;b&gt;Data rules&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Tune on validation, report on test once.&lt;br&gt;Downloads are verified before use.&lt;br&gt;Nothing is uploaded anywhere.&lt;/span&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#f7f7f5;strokeColor=#b8b7b1;strokeWidth=1.5;align=left;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450" y="360" width="300" height="150" as="geometry"/></mxCell><mxCell id="p2-26" value="&lt;b&gt;Model forward&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;ResNet-50 or DistilBERT → logits z&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450" y="780" width="300" height="64" as="geometry"/></mxCell><mxCell id="p2-27" value="&lt;b&gt;Loss + backward&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;cross-entropy L = −log p_y · autograd&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450" y="880" width="300" height="64" as="geometry"/></mxCell><mxCell id="p2-28" value="&lt;b&gt;Optimizer step&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;AdamW · warm-up / cosine LR · clip ‖g‖&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450" y="980" width="300" height="64" as="geometry"/></mxCell><mxCell id="p2-29" value="&lt;b&gt;Evaluate (each epoch)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;accuracy · F1 · confusion · best epoch&lt;/span&gt;" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e8f1fc;strokeColor=#2a78d6;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="450" y="1080" width="300" height="64" as="geometry"/></mxCell><mxCell id="p2-30" value="&lt;b&gt;Confidence ≥ τ ?&lt;/b&gt;" style="rhombus;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#fff6e0;strokeColor=#b07800;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="480" y="1180" width="240" height="100" as="geometry"/></mxCell><mxCell id="p2-31" value="&lt;b&gt;runs/checkpoints (safetensors)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;best epoch · reused by catch-up cells&lt;/span&gt;" style="shape=cylinder3;boundedLbl=1;size=8;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=13;fontColor=#0b0b0b;fillColor=#e6f6ef;strokeColor=#148f63;strokeWidth=1.5;align=center;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="810" y="1080" width="300" height="64" as="geometry"/></mxCell><mxCell id="p2-32" value="&lt;b&gt;TensorBoard + metrics.csv&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;every epoch of every run&lt;/span&gt;